# ==============================================================================
# OpencodeSilver Environment Configuration Template
# ==============================================================================

# --- Server & Network ---
OPENCODESILVER_HOST=127.0.0.1
OPENCODESILVER_PORT=3001
OPENCODESILVER_PUBLIC_ORIGIN=http://127.0.0.1:3001
OPENCODESILVER_API_PREFIX=/api

# --- Authentication & Security ---
# UI Session Password (protects web interface when accessed over network)
OPENCODESILVER_UI_PASSWORD=
# Inter-service communication token
OPENCODESILVER_SERVICE_TOKEN=
# Frame ancestors allowed in Content Security Policy (defaults to 'self')
OPENCODESILVER_FRAME_ANCESTORS='self'

# --- OpenCode Managed Core & CLI ---
OPENCODE_PORT=4096
OPENCODE_HOST=http://127.0.0.1:4096
OPENCODESILVER_OPENCODE_HOSTNAME=127.0.0.1
OPENCODESILVER_OPENCODE_BIN=
OPENCODE_SERVER_PASSWORD=

# --- Storage Directories ---
# Directory where user configurations and extensions are persisted
# Default: ~/.opencodesilver
OPENCODESILVER_DATA_DIR=
# Directory for conversation history and logs
OPENCODESILVER_CHATS_DIR=

# --- Extensions & Plugins ---
OPENCODESILVER_ALLOW_LOCAL_EXTENSIONS=true
OPENCODESILVER_ALLOWED_EXTENSIONS=

# --- Logging & Diagnostics ---
# Enable verbose request logging for debugging
OPENCODESILVER_VERBOSE_REQUEST_LOGS=false
# Record and output startup phase timings
OPENCODESILVER_STARTUP_PERF=false
