# Normalize line endings so a Windows checkout does not break shell scripts,
# checked-in bundles compared byte-for-byte in tests, or the installer.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
