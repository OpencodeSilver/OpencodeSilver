{
  "name": "@opencodesilver/core",
  "version": "3.0.2",
  "private": true,
  "description": "Core intelligence engine, mission orchestrator, and multi-model consensus matrix for OpencodeSilver",
  "author": "Ahmed (GEMTM)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
